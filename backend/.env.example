# Copy to .env and fill in. NEVER commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
DATABASE_URL=sqlite:///./data/app.db
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
# Optional regex for preview deployments, e.g. https://duolingo-clone-.*\.vercel\.app
CORS_ORIGIN_REGEX=
# Enables /dev endpoints such as "simulate next day"
DEMO_MODE=true
# Max agent pipeline runs + tutor chat calls per learner per day
AGENT_DAILY_BUDGET=40
